{%- comment -%}
  Floating contact form modal.

  Rendered once per "Floating buttons" section when at least one button has
  "Opens the contact form" enabled. Opened/closed by
  assets/floating-action-buttons.js:
    - [data-fab-open-form]  triggers showModal()
    - [data-fab-close-form] triggers close()
  assets/floating-action-buttons.js submits the form with fetch and swaps in
  the re-rendered result, so the success/error message shows without a page
  reload. [data-fab-form-posted] marks a posted render for that swap.
  Accepts:
    - section: the parent section (for section.id and section.settings)

  Colors are fixed to the store's palette (cream #FFF7F1, warm brown #4E3B34,
  dusty rose #9E6168), independent of the section's color scheme. Tweak the
  CSS variables at the top of the style block to adjust the palette.
{%- endcomment -%}

{%- liquid
  assign form_id = 'FloatingContactForm-' | append: section.id
  assign modal_title = section.settings.form_title | default: 'Get in touch with us!'
-%}

<style>
  #FloatingFormModal-{{ section.id }} {
    --ffm-bg: #FFF7F1;
    --ffm-fg: #4E3B34;
    --ffm-fg-soft: rgba(78, 59, 52, 0.65);
    --ffm-line: rgba(78, 59, 52, 0.25);
    --ffm-accent: #9E6168;
    --ffm-accent-fg: #FFF7F1;
    --ffm-panel: rgba(158, 97, 104, 0.08);

    border: none;
    padding: 0;
    background: var(--ffm-bg);
    color: var(--ffm-fg);
    font-family: var(--font-body-family, inherit);
    border-radius: 24px;
    width: min(920px, calc(100vw - 32px));
    max-height: min(90vh, 720px);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  #FloatingFormModal-{{ section.id }} .floating-form-modal__layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    min-height: 480px;
    max-height: inherit;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  #FloatingFormModal-{{ section.id }}::backdrop {
    background: rgba(0, 0, 0, 0.55);
  }

  #FloatingFormModal-{{ section.id }} .floating-form-modal__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 50%;
    color: inherit;
    cursor: pointer;
  }

  #FloatingFormModal-{{ section.id }} .floating-form-modal__close:hover {
    background: rgba(78, 59, 52, 0.08);
  }

  #FloatingFormModal-{{ section.id }} .floating-form-modal__close .svg-wrapper {
    width: 18px;
    height: 18px;
  }

  #FloatingFormModal-{{ section.id }} .floating-form-modal__close svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  /* Intro panel */
  #FloatingFormModal-{{ section.id }} .floating-form-modal__intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    padding: 48px 40px;
    background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%239E6168' fill-opacity='0.12' fill-rule='evenodd'%3E%3Ccircle cx='3' cy='3' r='1.6'/%3E%3Ccircle cx='13' cy='13' r='1.6'/%3E%3C/g%3E%3C/svg%3E");
    background-size: 20px 20px;
  }

  #FloatingFormModal-{{ section.id }} .floating-form-modal__badge {
    align-self: flex-start;
    padding: 8px 18px;
    border: 1px solid var(--ffm-line);
    border-radius: 10px;
    font-size: 1.3rem;
    color: var(--ffm-fg);
  }

  #FloatingFormModal-{{ section.id }} .floating-form-modal__heading {
    margin: 0;
    font-size: 3.6rem;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ffm-fg);
  }

  #FloatingFormModal-{{ section.id }} .floating-form-modal__text {
    margin: 0;
    max-width: 34ch;
    font-size: 1.4rem;
    line-height: 1.6;
    color: var(--ffm-fg-soft);
  }

  /* Form panel */
  #FloatingFormModal-{{ section.id }} .floating-form-modal__panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 16px;
    padding: 40px 36px;
    border-radius: 16px;
    background: var(--ffm-panel);
  }

  #FloatingFormModal-{{ section.id }} .floating-form-modal__panel-title {
    margin: 0 0 28px;
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--ffm-fg);
  }

  #FloatingFormModal-{{ section.id }} .floating-form__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px 24px;
  }

  #FloatingFormModal-{{ section.id }} .floating-form__field {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  #FloatingFormModal-{{ section.id }} .floating-form__field--full {
    grid-column: 1 / -1;
  }

  #FloatingFormModal-{{ section.id }} .floating-form__input {
    width: 100%;
    padding: 8px 0 12px;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--ffm-line);
    border-radius: 0;
    font-family: inherit;
    font-size: 1.5rem;
    color: var(--ffm-fg);
    caret-color: var(--ffm-accent);
    transition: border-color 0.2s ease;
    appearance: none;
    box-shadow: none;
  }

  #FloatingFormModal-{{ section.id }} .floating-form__input::placeholder {
    color: var(--ffm-fg-soft);
    opacity: 1;
  }

  #FloatingFormModal-{{ section.id }} .floating-form__input:focus {
    outline: none;
  }

  /* Accent underline that sweeps in when the field is focused */
  #FloatingFormModal-{{ section.id }} .floating-form__field::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--ffm-accent);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.25s ease;
  }

  #FloatingFormModal-{{ section.id }} .floating-form__field:focus-within::after {
    transform: scaleX(1);
  }

  #FloatingFormModal-{{ section.id }} textarea.floating-form__input {
    resize: vertical;
    min-height: 60px;
  }

  #FloatingFormModal-{{ section.id }} .floating-form__submit {
    justify-self: start;
    margin-top: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 34px;
    background: linear-gradient(135deg, var(--ffm-accent) 0%, color-mix(in srgb, var(--ffm-accent) 78%, var(--ffm-fg)) 100%);
    color: var(--ffm-accent-fg);
    border: none;
    border-radius: 10px;
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: 0 6px 18px color-mix(in srgb, var(--ffm-accent) 40%, transparent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #FloatingFormModal-{{ section.id }} .floating-form__submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--ffm-accent) 50%, transparent);
  }

  #FloatingFormModal-{{ section.id }} .floating-form__submit:active {
    transform: translateY(0);
  }

  #FloatingFormModal-{{ section.id }} .floating-form__status {
    grid-column: 1 / -1;
    margin: 0;
    padding: 12px 16px;
    border-radius: 8px;
    background: var(--ffm-panel);
    color: var(--ffm-fg);
    font-size: 1.3rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #FloatingFormModal-{{ section.id }} .floating-form__status .svg-wrapper {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  #FloatingFormModal-{{ section.id }} .floating-form__status .svg-wrapper svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  #FloatingFormModal-{{ section.id }} .floating-form__status a {
    color: inherit;
  }

  @media screen and (max-width: 749px) {
    #FloatingFormModal-{{ section.id }} {
      width: min(920px, calc(100vw - 16px));
    }

    #FloatingFormModal-{{ section.id }} .floating-form-modal__close {
      top: 10px;
      right: 10px;
      width: 36px;
      height: 36px;
    }

    #FloatingFormModal-{{ section.id }} .floating-form-modal__layout {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    #FloatingFormModal-{{ section.id }} .floating-form-modal__intro {
      padding: 32px 22px 4px;
      gap: 12px;
    }

    #FloatingFormModal-{{ section.id }} .floating-form-modal__heading {
      font-size: 2.6rem;
      padding-right: 36px;
    }

    #FloatingFormModal-{{ section.id }} .floating-form-modal__panel {
      margin: 8px 8px 8px;
      padding: 24px 18px;
    }

    #FloatingFormModal-{{ section.id }} .floating-form-modal__panel-title {
      margin-bottom: 20px;
    }

    #FloatingFormModal-{{ section.id }} .floating-form__fields {
      grid-template-columns: 1fr 1fr;
      gap: 18px 14px;
    }

    #FloatingFormModal-{{ section.id }} textarea.floating-form__input {
      min-height: 50px;
    }

    #FloatingFormModal-{{ section.id }} .floating-form__submit {
      grid-column: 1 / -1;
      justify-self: stretch;
      width: 100%;
      margin-top: 24px;
      padding: 14px 24px;
    }
  }
</style>

<dialog
  id="FloatingFormModal-{{ section.id }}"
  class="floating-form-modal"
  aria-labelledby="FloatingFormModal-{{ section.id }}-title"
>
  <button
    type="button"
    class="floating-form-modal__close"
    aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
    data-fab-close-form
  >
    <span class="svg-wrapper">
      {{- 'icon-close.svg' | inline_asset_content -}}
    </span>
  </button>

  <div class="floating-form-modal__layout">
    <div class="floating-form-modal__intro">
      {%- if section.settings.form_badge != blank -%}
        <span class="floating-form-modal__badge">{{ section.settings.form_badge | escape }}</span>
      {%- endif -%}

      <h2 class="floating-form-modal__heading" id="FloatingFormModal-{{ section.id }}-title">
        {{- modal_title | escape -}}
      </h2>

      {%- if section.settings.form_description != blank -%}
        <p class="floating-form-modal__text">{{ section.settings.form_description | escape }}</p>
      {%- endif -%}
    </div>

    <div class="floating-form-modal__panel">
      <h3 class="floating-form-modal__panel-title">{{ section.settings.form_panel_title | default: 'Contact Us' | escape }}</h3>

      {%- form 'contact', id: form_id, class: 'floating-form' -%}
        {%- if form.posted_successfully? or form.errors -%}
          <span hidden data-fab-form-posted></span>
        {%- endif -%}

        <div class="floating-form__fields">
          {%- if form.posted_successfully? -%}
            <p class="floating-form__status" tabindex="-1" autofocus role="status">
              <span class="svg-wrapper">
                {{- 'icon-success.svg' | inline_asset_content -}}
              </span>
              {{ 'templates.contact.form.post_success' | t }}
            </p>
          {%- elsif form.errors -%}
            <p class="floating-form__status" tabindex="-1" autofocus role="alert">
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- endif -%}

          <div class="floating-form__field">
            <label class="visually-hidden" for="{{ form_id }}-first-name">First name</label>
            <input
              class="floating-form__input"
              type="text"
              id="{{ form_id }}-first-name"
              name="contact[First Name]"
              autocomplete="given-name"
              placeholder="First Name"
              {% if customer %}value="{{ customer.first_name }}"{% endif %}
            >
          </div>

          <div class="floating-form__field">
            <label class="visually-hidden" for="{{ form_id }}-last-name">Last name</label>
            <input
              class="floating-form__input"
              type="text"
              id="{{ form_id }}-last-name"
              name="contact[Last Name]"
              autocomplete="family-name"
              placeholder="Last Name"
              {% if customer %}value="{{ customer.last_name }}"{% endif %}
            >
          </div>

          <div class="floating-form__field">
            <label class="visually-hidden" for="{{ form_id }}-postal">Postal code</label>
            <input
              class="floating-form__input"
              type="text"
              id="{{ form_id }}-postal"
              name="contact[Postal Code]"
              autocomplete="postal-code"
              placeholder="Postal Code"
            >
          </div>

          <div class="floating-form__field">
            <label class="visually-hidden" for="{{ form_id }}-email">
              Email address <span aria-hidden="true">*</span>
            </label>
            <input
              class="floating-form__input"
              type="email"
              id="{{ form_id }}-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              placeholder="Email Address"
              value="{{ form.email }}"
              aria-required="true"
              required
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="floating-form__field floating-form__field--full">
            <label class="visually-hidden" for="{{ form_id }}-body">Message</label>
            <textarea
              class="floating-form__input"
              id="{{ form_id }}-body"
              name="contact[body]"
              rows="3"
              placeholder="Message"
            >{{ form.body }}</textarea>
          </div>

          <button type="submit" class="floating-form__submit">
            {{ 'templates.contact.form.send' | t | default: 'Submit' }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</dialog>
