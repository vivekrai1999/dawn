{% comment %}
  Product showcase — a heading, a description, circular carousel controls and a
  row of product cards drawn from a collection or from manually picked products.

  Everything product-facing is Dawn's own: `card-product` renders the cards
  (responsive images, badges, price, secondary-image hover), `slider-component`
  drives the carousel, and quick add runs through Dawn's `product-form` /
  `quick-add-modal`, so it lands in the existing cart drawer. No carousel
  library is added: `slider-component` is already scroll-snap based, which gives
  native touch and momentum scrolling for free.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-card-showcase.css' | asset_url | stylesheet_tag }}
{{ 'section-product-showcase.css' | asset_url | stylesheet_tag }}

{%- if section.settings.show_quick_add -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  comment
    One product list feeds the cards whichever source the merchant picked, so a
    single card component renders both paths.
  endcomment
  if section.settings.product_source == 'manual'
    assign products = section.blocks | where: 'type', 'product' | map: 'settings' | map: 'product' | compact
  else
    assign products = section.settings.collection.products
    comment
      With no collection chosen the section would render nothing at all, which
      reads as broken. Fall back to the shop's own products — real catalogue
      data, never placeholders, on the live storefront.
    endcomment
    if section.settings.collection == blank
      assign products = collections.all.products
    endif
  endif

  comment
    products is nil when the source is Collection and none is selected yet, so
    default the count to 0 rather than relying on nil.size.
  endcomment
  assign products_count = 0
  if products != blank
    assign products_count = products.size | at_most: section.settings.products_limit
  endif

  assign quick_add_type = 'none'
  if section.settings.show_quick_add
    assign quick_add_type = 'standard'
  endif

  assign show_carousel = false
  if section.settings.enable_carousel and products_count > section.settings.columns_desktop
    assign show_carousel = true
  endif

  comment
    Colour settings can be cleared in the editor, so resolve each one before it
    reaches the style block.
  endcomment
  assign heading_color = section.settings.heading_color | default: '#1a1a1a'
  assign text_color = section.settings.text_color | default: '#5c5c5c'
  assign title_color = section.settings.card_title_color | default: '#1a1a1a'
  assign price_color = section.settings.card_price_color | default: '#5c5c5c'
  assign button_bg = section.settings.button_background_color | default: '#000000'
  assign button_icon = section.settings.button_icon_color | default: '#ffffff'
-%}

{%- style -%}
  #ProductShowcase-{{ section.id }} {
    --showcase-width: {{ section.settings.content_width }}px;
    --showcase-gap: {{ section.settings.grid_gap }}px;
    --showcase-columns: {{ section.settings.columns_desktop }};
    --showcase-columns-tablet: {{ section.settings.columns_tablet }};
    --showcase-columns-mobile: {{ section.settings.columns_mobile }};
    --showcase-padding-top: {{ section.settings.padding_top }}px;
    --showcase-padding-bottom: {{ section.settings.padding_bottom }}px;

    --showcase-heading: {{ heading_color }};
    --showcase-text: {{ text_color }};
    --showcase-heading-size: {{ section.settings.heading_size }}px;
    --showcase-text-size: {{ section.settings.description_size }}px;
    --showcase-description-width: {{ section.settings.description_width }}px;

    --card-title-color: {{ title_color }};
    --card-price-color: {{ price_color }};
    --card-media-radius: {{ section.settings.card_media_radius }}px;
    --card-title-size: {{ section.settings.card_title_size }}px;
    --card-price-size: {{ section.settings.card_price_size }}px;

    --card-button-bg: {{ button_bg }};
    --card-button-icon: {{ button_icon }};
    --card-button-size: {{ section.settings.button_size }}px;
  }

  {%- if section.settings.background_color != blank -%}
    #ProductShowcase-{{ section.id }} {
      background-color: {{ section.settings.background_color }};
    }
  {%- endif -%}
{%- endstyle -%}

<section
  class="product-showcase{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  id="ProductShowcase-{{ section.id }}"
  {% if section.settings.heading != blank %}
    aria-labelledby="ShowcaseHeading-{{ section.id }}"
  {% endif %}
>
  <div class="product-showcase__inner">
    {%- if section.settings.heading != blank
      or section.settings.description != blank
      or show_carousel
    -%}
      <div class="product-showcase__header">
        <div class="product-showcase__intro">
          {%- if section.settings.heading != blank -%}
            <h2 class="product-showcase__heading" id="ShowcaseHeading-{{ section.id }}">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <div class="product-showcase__description rte">{{ section.settings.description }}</div>
          {%- endif -%}
        </div>

      </div>
    {%- endif -%}

    {%- if products_count > 0 -%}
      <slider-component class="product-showcase__slider{% unless show_carousel %} product-showcase__slider--static{% endunless %}">
        {%- if show_carousel and section.settings.show_navigation -%}
          <div class="product-showcase__controls">
            <button
              type="button"
              name="previous"
              class="product-showcase__arrow product-showcase__arrow--prev"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <span class="svg-wrapper" aria-hidden="true">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </button>
            <button
              type="button"
              name="next"
              class="product-showcase__arrow product-showcase__arrow--next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <span class="svg-wrapper" aria-hidden="true">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        {%- endif -%}

        <ul
          class="product-showcase__track{% if show_carousel %} slider slider--everywhere{% endif %}"
          id="Slider-{{ section.id }}"
          role="list"
        >
          {%- for product in products limit: section.settings.products_limit -%}
            {%- if product == blank -%}
              {%- continue -%}
            {%- endif -%}
            <li
              class="product-showcase__item{% if show_carousel %} slider__slide{% endif %}"
              id="Slide-{{ section.id }}-{{ forloop.index }}"
            >
              {%- liquid
                comment
                  The first row of cards is above the fold, so those images are
                  not lazy loaded — lazy loading them delays LCP.
                endcomment
                assign lazy_load_card = true
                if forloop.index <= section.settings.columns_desktop
                  assign lazy_load_card = false
                endif
              -%}
              {%- render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_rating: false,
                section_id: section.id,
                quick_add: quick_add_type,
                quick_add_style: 'icon',
                card_variant: 'showcase',
                lazy_load: lazy_load_card,
                skip_styles: true
              -%}
            </li>
          {%- endfor -%}
        </ul>
      </slider-component>
    {%- elsif request.design_mode -%}
      <ul class="product-showcase__track" role="list">
        {%- for i in (1..section.settings.columns_desktop) -%}
          <li class="product-showcase__item">
            {%- render 'card-product',
              media_aspect_ratio: section.settings.image_ratio,
              section_id: section.id,
              card_variant: 'showcase',
              skip_styles: true
            -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product showcase",
  "tag": "section",
  "class": "product-showcase-section",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Handmade crochet"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Cotton, wool and jute worked by hand into pieces made to be used every day — and to last.</p>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 40
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 15
    },
    {
      "type": "range",
      "id": "description_width",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Description width",
      "default": 760
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "Product source",
      "options": [
        {
          "value": "collection",
          "label": "Collection"
        },
        {
          "value": "manual",
          "label": "Selected products"
        }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when the source is Collection. Leave blank to show all products. Add Product blocks for the manual source."
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 2,
      "max": 24,
      "step": 1,
      "label": "Maximum products",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products per row (desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Products per row (tablet)",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Products per row (mobile)",
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap between products",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 1000,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1800
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable carousel",
      "info": "Applies when there are more products than fit in a row.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.featured-collection.settings.image_ratio.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.featured-collection.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.featured-collection.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.featured-collection.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "card_media_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.featured-collection.settings.show_secondary_image.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.featured-collection.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
      "default": true
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 15
    },
    {
      "type": "range",
      "id": "card_price_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Price size",
      "default": 15
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 36,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Quick add button size",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "info": "Leave blank to inherit the page background."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#4E3B34"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description",
      "default": "#786158"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Product title",
      "default": "#4E3B34"
    },
    {
      "type": "color",
      "id": "card_price_color",
      "label": "Price",
      "default": "#786158"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Quick add background",
      "default": "#9E6168"
    },
    {
      "type": "color",
      "id": "button_icon_color",
      "label": "Quick add icon",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Product showcase"
    }
  ]
}
{% endschema %}
