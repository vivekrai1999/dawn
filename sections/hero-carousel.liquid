{% comment %}
  Hero carousel — a full-bleed slideshow built on Slick Carousel.

  Slides are section blocks, so the merchant adds, reorders and removes them in
  the Theme Editor. Slick is driven by the <hero-carousel> custom element in
  assets/hero-carousel.js, which handles the editor's re-render lifecycle and
  keeps each instance independent.

  Reused from the theme: the colour-scheme system, the `.button` component,
  `icon-arrow.svg`, Dawn's image_url/image_tag responsive helpers and the
  animations setting.
{% endcomment %}

{{ 'slick.css' | asset_url | stylesheet_tag }}
{{ 'section-hero-carousel.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Slick 1.8.1 requires jQuery. Both are vendored in assets/ (see package.json)
  rather than pulled from a CDN, and both are deferred so neither blocks the
  hero image, which is the likely LCP element.
{%- endcomment -%}
<script src="{{ 'jquery.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'slick.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'hero-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'

  comment
    A slide with neither media nor text would render an empty panel.
  endcomment
  assign renderable = 0
  for block in slides
    if block.settings.image != blank or block.settings.heading != blank or block.settings.eyebrow != blank
      assign renderable = renderable | plus: 1
    endif
  endfor

  assign show_controls = false
  if renderable > 1
    assign show_controls = true
  endif
-%}

{%- if renderable > 0 -%}
  {%- style -%}
    #HeroCarousel-{{ section.id }} {
      --hero-height: {{ section.settings.height_desktop }}svh;
      --hero-height-mobile: {{ section.settings.height_mobile }}svh;
      --hero-content-width: {{ section.settings.content_width }}px;
      --hero-heading-size: {{ section.settings.heading_size }}px;
      --hero-eyebrow-size: {{ section.settings.eyebrow_size }}px;
      --hero-text-size: {{ section.settings.text_size }}px;
      --hero-gutter: {{ section.settings.content_gutter }}px;
      --hero-scrim: {{ section.settings.scrim_strength | divided_by: 100.0 }};
      --hero-min-height: calc(var(--hero-height-mobile) * 1vh);
    }

    #shopify-section-{{ section.id }} {
      margin-block: {{ section.settings.margin_top }}px {{ section.settings.margin_bottom }}px;
    }

    {%- for block in slides -%}
      #HeroSlide-{{ block.id }} {
        --hero-overlay: {{ block.settings.overlay_color | default: '#000000' }};
        --hero-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
        --hero-object-position: {{ block.settings.image_position }};
      }
    {%- endfor -%}
  {%- endstyle -%}

  <hero-carousel
    class="hero-carousel color-{{ section.settings.color_scheme }} hero-carousel--mobile-{{ section.settings.mobile_content_position }}{% unless section.settings.full_width %} hero-carousel--contained{% endunless %}{% unless section.settings.show_scrim %} hero-carousel--no-scrim{% endunless %} hero-carousel--height-protected"
    id="HeroCarousel-{{ section.id }}"
    data-arrows="{% if section.settings.show_arrows and show_controls %}true{% else %}false{% endif %}"
    data-dots="{% if section.settings.pagination == 'dots' and show_controls %}true{% else %}false{% endif %}"
    data-infinite="{{ section.settings.infinite }}"
    data-autoplay="{% if section.settings.autoplay and show_controls %}true{% else %}false{% endif %}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
    data-speed="{{ section.settings.transition_speed }}"
    data-transition="{{ section.settings.transition }}"
    data-pause-on-hover="{{ section.settings.pause_on_hover }}"
    data-slide-label="{{ 'sections.slideshow.load_slide' | t | escape }}"
  >
    <div
      class="hero-carousel__slider"
      data-hero-slider
      role="region"
      aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
      aria-label="{{ section.settings.accessibility_info | default: shop.name | escape }}"
    >
      {%- for block in slides -%}
        {%- liquid
          if block.settings.image == blank and block.settings.heading == blank and block.settings.eyebrow == blank
            continue
          endif

          comment
            The first slide is the LCP candidate: it loads eagerly at high
            priority. Later slides are lazy — Slick keeps them in the DOM, so
            eager-loading every hero image would be a large, wasted download.
          endcomment
          assign is_first = false
          if forloop.first
            assign is_first = true
          endif

          comment
            One H1 per page: the first slide carries it, the rest use H2 so the
            outline stays valid.
          endcomment
          assign heading_tag = 'h2'
          if is_first and section.settings.first_slide_is_h1
            assign heading_tag = 'h1'
          endif

          assign mobile_image = block.settings.image_mobile | default: block.settings.image
        -%}
        <div
          class="hero-carousel__slide hero-carousel__slide--{{ block.settings.content_position }} hero-carousel__slide--text-{{ block.settings.text_alignment }}"
          id="HeroSlide-{{ block.id }}"
          data-hero-slide
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="hero-carousel__media">
              {%- comment -%}
                Alt text comes from the image the merchant uploaded; it is never
                invented here. A decorative image with no alt stays empty.
              {%- endcomment -%}
              <picture>
                {%- if mobile_image != block.settings.image -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 450 }} 450w,
                      {{ mobile_image | image_url: width: 750 }} 750w,
                      {{ mobile_image | image_url: width: 1100 }} 1100w,
                      {{ mobile_image | image_url: width: 1500 }} 1500w
                    "
                    sizes="100vw"
                    width="{{ mobile_image.width }}"
                    height="{{ mobile_image.height }}"
                  >
                {%- endif -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1500 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 750 }} 750w,
                    {{ block.settings.image | image_url: width: 1100 }} 1100w,
                    {{ block.settings.image | image_url: width: 1500 }} 1500w,
                    {{ block.settings.image | image_url: width: 2000 }} 2000w,
                    {{ block.settings.image | image_url: width: 3000 }} 3000w
                  "
                  sizes="100vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  class="hero-carousel__image"
                  {% if is_first %}
                    loading="eager"
                    fetchpriority="high"
                  {% else %}
                    loading="lazy"
                  {% endif %}
                >
              </picture>
              {%- if block.settings.show_overlay -%}
                <span class="hero-carousel__overlay" aria-hidden="true"></span>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="hero-carousel__content color-{{ block.settings.color_scheme }}">
            <div class="hero-carousel__content-inner">
              {%- if block.settings.eyebrow != blank -%}
                <p class="hero-carousel__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <{{ heading_tag }} class="hero-carousel__heading">
                  {{- block.settings.heading | escape -}}
                </{{ heading_tag }}>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="hero-carousel__description rte">{{ block.settings.description }}</div>
              {%- endif -%}

              {%- if block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
                <div class="hero-carousel__actions">
                  {%- if block.settings.button_label != blank -%}
                    <a
                      class="hero-carousel__button button{% unless block.settings.button_style_primary %} button--secondary{% endunless %}"
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                    >
                      {{- block.settings.button_label | escape -}}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_2 != blank -%}
                    <a
                      class="hero-carousel__button button{% unless block.settings.button_style_secondary %} button--secondary{% endunless %}"
                      {% if block.settings.button_link_2 == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link_2 }}"
                      {% endif %}
                    >
                      {{- block.settings.button_label_2 | escape -}}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if show_controls -%}
      <div class="hero-carousel__controls">
        {%- if section.settings.show_arrows -%}
          <button
            type="button"
            class="hero-carousel__arrow hero-carousel__arrow--prev hero-carousel__arrow--{{ section.settings.arrow_style }}"
            data-hero-prev
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </button>
        {%- endif -%}

        {%- if section.settings.pagination == 'dots' -%}
          <div class="hero-carousel__dots" data-hero-dots></div>
        {%- elsif section.settings.pagination == 'counter' -%}
          <p class="hero-carousel__counter">
            <span data-hero-counter-current>01</span>
            <span aria-hidden="true"> / </span>
            <span>{{ renderable | prepend: '0' | slice: -2, 2 }}</span>
          </p>
        {%- endif -%}

        {%- if section.settings.show_arrows -%}
          <button
            type="button"
            class="hero-carousel__arrow hero-carousel__arrow--next hero-carousel__arrow--{{ section.settings.arrow_style }}"
            data-hero-next
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </hero-carousel>
{%- endif -%}

{% schema %}
{
  "name": "Hero carousel",
  "tag": "section",
  "class": "hero-carousel-section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Falls back to the desktop image."
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image focal point",
          "options": [
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            },
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "New collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Craft your signature look"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Consider your favorite colors, patterns, and textures, as well as the pieces you feel most confident in.</p>"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            {
              "value": "top-left",
              "label": "Top left"
            },
            {
              "value": "top-center",
              "label": "Top center"
            },
            {
              "value": "top-right",
              "label": "Top right"
            },
            {
              "value": "middle-left",
              "label": "Middle left"
            },
            {
              "value": "middle-center",
              "label": "Middle center"
            },
            {
              "value": "middle-right",
              "label": "Middle right"
            },
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "bottom-center",
              "label": "Bottom center"
            },
            {
              "value": "bottom-right",
              "label": "Bottom right"
            }
          ],
          "default": "middle-left"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "t:sections.image-banner.settings.desktop_content_alignment.label",
          "options": [
            {
              "value": "left",
              "label": "t:sections.image-banner.settings.desktop_content_alignment.options__1.label"
            },
            {
              "value": "center",
              "label": "t:sections.image-banner.settings.desktop_content_alignment.options__2.label"
            },
            {
              "value": "right",
              "label": "t:sections.image-banner.settings.desktop_content_alignment.options__3.label"
            }
          ],
          "default": "left"
        },
        {
          "type": "header",
          "content": "Buttons"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Primary button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_primary",
          "label": "Use solid style",
          "default": true
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary button label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "Use solid style",
          "default": false
        },
        {
          "type": "header",
          "content": "Overlay"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Text color scheme",
          "info": "Pick a dark scheme for light imagery and a light scheme for dark imagery. This sets the slide's text, buttons and the shade drawn behind them.",
          "default": "scheme-1"
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show overlay",
          "default": true
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "label": "Overlay opacity",
          "default": 25
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "first_slide_is_h1",
      "label": "Use the first heading as the page title (H1)",
      "info": "Turn off if another section on the page already provides the H1.",
      "default": true
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "Carousel description",
      "info": "Describes the carousel to screen readers.",
      "default": "Hero carousel"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Desktop height",
      "info": "Percentage of the viewport height.",
      "default": 85
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Mobile height",
      "default": 75
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 320,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 600
    },
    {
      "type": "range",
      "id": "content_gutter",
      "min": 16,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Content inset",
      "default": 72
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Mobile content position",
      "info": "Overrides each slide's position on small screens.",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "header",
      "content": "Text legibility"
    },
    {
      "type": "checkbox",
      "id": "show_scrim",
      "label": "Shade behind text",
      "info": "Fades a shadow in behind the text only, so the rest of the image stays untouched. Keep this on unless every slide uses a dark image.",
      "default": true
    },
    {
      "type": "range",
      "id": "scrim_strength",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Shade strength",
      "default": 75
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 72
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow size",
      "default": 13
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Transition",
      "options": [
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ],
      "default": "slide"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "min": 200,
      "max": 1200,
      "step": 50,
      "unit": "ms",
      "label": "Transition speed",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "info": "Always off for visitors who prefer reduced motion.",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Controls"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "arrow_style",
      "label": "Arrow style",
      "options": [
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "filled",
          "label": "Filled"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ],
      "default": "outline"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "Pagination",
      "options": [
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "counter",
          "label": "Counter"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "dots"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "New collection",
            "heading": "Craft your signature look",
            "button_label": "Shop now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "New arrivals",
            "heading": "Everyday, elevated",
            "button_label": "Explore"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Seasonal edit",
            "heading": "Find your next favorite",
            "button_label": "Discover"
          }
        }
      ]
    }
  ]
}
{% endschema %}
