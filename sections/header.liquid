{% comment %}theme-check-disable ExcessiveSettingsCount{% endcomment %}
{% comment %}
  The theme's header: brand on the left, a floating navigation pill holding the
  menu and the search / account / cart actions on the right.

  Everything interactive here is Dawn's own: `header-drawer` for the mobile
  menu, `header-dropdown-menu` / `header-mega-menu` for nested navigation,
  `header-search` for the search modal and predictive search, Shopify's
  `<shopify-account>` element, and the cart link's `#cart-icon-bubble` id,
  which `cart-drawer.js` binds to in order to open the cart drawer.

  The top bar above this section is `sections/announcement-bar.liquid`.
{% endcomment %}

<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
{{ 'section-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'nav-scroller.js' | asset_url }}" defer="defer"></script>

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign has_app_block = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor

  assign country_selector = false
  if section.settings.enable_country_selector and localization.available_countries.size > 1
    assign country_selector = true
  endif

  assign language_selector = false
  if section.settings.enable_language_selector and localization.available_languages.size > 1
    assign language_selector = true
  endif

  assign social_links = false
  if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
    assign social_links = true
  endif

  assign header_tag = 'div'
  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif

  assign brand_text = section.settings.brand_text | default: shop.name

  comment
    Colour settings can be cleared in the editor, so resolve every one of them
    to a concrete value before it reaches the style block.
  endcomment
  assign nav_bg = section.settings.nav_background_color | default: '#ffffff'
  assign nav_text = section.settings.nav_text_color | default: '#1a1a1a'
  assign nav_text_hover = section.settings.nav_text_hover_color | default: nav_text
  assign nav_border = section.settings.nav_border_color | default: '#ffffff'
  assign icon_color = section.settings.icon_color | default: nav_text
  assign brand_color = section.settings.brand_color | default: '#ffffff'
  assign sticky_bg = section.settings.sticky_background_color | default: '#ffffff'
  assign panel_bg = section.settings.panel_background_color | default: '#ffffff'
  assign panel_text = section.settings.panel_text_color | default: '#1a1a1a'
  assign panel_accent = section.settings.panel_accent_color | default: '#1a1a1a'
  assign panel_accent_text = section.settings.panel_accent_text_color | default: '#ffffff'
  assign mobile_header_bg = section.settings.mobile_header_background | default: '#ffffff'
  assign mobile_brand_color = section.settings.mobile_brand_color | default: '#1a1a1a'
  assign mobile_icon_color = section.settings.mobile_icon_color | default: mobile_brand_color
  assign mobile_menu_bg = section.settings.mobile_menu_background | default: '#ffffff'
  assign mobile_menu_text = section.settings.mobile_menu_text_color | default: '#1a1a1a'
  assign login_bg = section.settings.login_background_color | default: '#000000'
  assign login_text = section.settings.login_text_color | default: '#ffffff'

  assign nav_alpha = section.settings.nav_opacity | divided_by: 100.0
  assign nav_border_alpha = section.settings.nav_border_opacity | divided_by: 100.0
-%}

{%- style -%}
  #Header-{{ section.id }} {
    --header-width: {{ section.settings.header_width }}px;
    --header-padding-block: {{ section.settings.padding_top }}px;
    --header-height-mobile: {{ section.settings.mobile_header_height }}px;
    --header-logo-width: {{ settings.logo_width }}px;
    --header-logo-width-mobile: {{ section.settings.mobile_logo_width }}px;
    --header-brand-color: {{ brand_color }};
    --header-brand-font-size: {{ section.settings.brand_font_size }}px;
    --header-sticky-bg: {{ sticky_bg }};

    --nav-bg: rgba({{ nav_bg | color_extract: 'red' }}, {{ nav_bg | color_extract: 'green' }}, {{ nav_bg | color_extract: 'blue' }}, {{ nav_alpha }});
    --nav-border-color: rgba({{ nav_border | color_extract: 'red' }}, {{ nav_border | color_extract: 'green' }}, {{ nav_border | color_extract: 'blue' }}, {{ nav_border_alpha }});
    --nav-border-width: {{ section.settings.nav_border_width }}px;
    --nav-radius: {{ section.settings.nav_radius }}px;
    --nav-blur: {{ section.settings.nav_blur }}px;
    --nav-text: {{ nav_text }};
    --nav-text-hover: {{ nav_text_hover }};
    --nav-font-size: {{ section.settings.nav_font_size }}px;
    --nav-text-transform: {% if section.settings.nav_uppercase %}uppercase{% else %}none{% endif %};
    --nav-letter-spacing: {{ section.settings.nav_letter_spacing | divided_by: 100.0 }}em;
    --nav-link-gap: {{ section.settings.nav_link_gap }}px;
    --nav-padding-inline: {{ section.settings.nav_padding_inline }}px;
    --nav-padding-block: {{ section.settings.nav_padding_block }}px;
    --nav-padding-inline-mobile: {{ section.settings.nav_padding_inline | at_most: 16 }}px;
    --nav-padding-block-mobile: {{ section.settings.nav_padding_block | at_most: 8 }}px;
    --nav-max-width: {{ section.settings.nav_max_width }}px;

    --icon-size: {{ section.settings.icon_size }}px;
    --icon-color: {{ icon_color }};
    --icon-gap: {{ section.settings.icon_gap }}px;
    --icon-hover-bg: rgba({{ nav_text | color_extract: 'red' }}, {{ nav_text | color_extract: 'green' }}, {{ nav_text | color_extract: 'blue' }}, 0.08);
  }

  :root {
    --panel-bg: {{ panel_bg }};
    --panel-text: {{ panel_text }};
    --panel-border: rgba({{ panel_text | color_extract: 'red' }}, {{ panel_text | color_extract: 'green' }}, {{ panel_text | color_extract: 'blue' }}, 0.2);
    --panel-accent: {{ panel_accent }};
    --panel-accent-text: {{ panel_accent_text }};
    --panel-inline: {{ section.settings.panel_padding_inline }}px;
    --panel-overlay-opacity: {{ section.settings.panel_overlay_opacity | divided_by: 100.0 }};
    --panel-offset: {{ section.settings.panel_offset }}px;
  }

  #Header-{{ section.id }} .header {
    padding-block: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  .section-header {
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    #Header-{{ section.id }} .header {
      padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    }
  }

  {%- comment -%}
    Overlay is applied per breakpoint so mobile can stay in normal flow while
    desktop floats over the hero. No `top` is set, so the section keeps its
    static position — directly under the announcement bar — and the section
    below it slides up beneath the header instead of shifting.
  {%- endcomment -%}
  {%- capture overlay_rules -%}
    /*
      Overlay without taking the header out of flow.

      An absolutely positioned header relies on its static position resolving
      against the initial containing block, which is easy to disturb. Staying in
      flow with zero height is unconditional: the section always sits exactly
      where the announcement bar leaves it, contributes no height of its own, and
      its contents overflow down over the section below.
    */
    #shopify-section-{{ section.id }} {
      position: relative;
      z-index: 4;
      height: 0;
    }

    #shopify-section-{{ section.id }} .header-wrapper {
      background-color: transparent;
    }

    /*
      Once Dawn's sticky JS reports the header has genuinely been scrolled past,
      it detaches. `top` is deliberately not set here so base.css keeps ownership
      of its sticky (top: 0), hidden (top: -header-height) and `.animate`
      transition states — setting it at id specificity would out-rank them and
      break the hide/reveal animation.
    */
    #shopify-section-{{ section.id }}.scrolled-past-header {
      position: fixed;
      inset-inline: 0;
      height: auto;
    }

    {%- if section.settings.sticky_opaque -%}
      /* Opt-in solid bar once the header detaches from the top of the page. */
      #shopify-section-{{ section.id }}.scrolled-past-header .header-wrapper {
        background-color: {{ sticky_bg }};
      }
    {%- endif -%}
  {%- endcapture -%}

  {%- if section.settings.header_position == 'overlay' -%}
    @media screen and (min-width: 990px) {
      {{ overlay_rules }}
    }
  {%- endif -%}

  {%- if section.settings.mobile_header_position == 'overlay' -%}
    @media screen and (max-width: 989px) {
      {{ overlay_rules }}
    }
  {%- endif -%}

  @media screen and (max-width: 989px) {
    #Header-{{ section.id }} {
      --mobile-header-bg: {{ mobile_header_bg }};
      --mobile-brand-color: {{ mobile_brand_color }};
      --mobile-icon-color: {{ mobile_icon_color }};

      --mobile-menu-bg: {{ mobile_menu_bg }};
      --mobile-menu-text: {{ mobile_menu_text }};
      --mobile-menu-inset: {{ section.settings.mobile_menu_inset }}px;
      --mobile-menu-radius: {{ section.settings.mobile_menu_radius }}px;
      --mobile-menu-font-size: {{ section.settings.mobile_menu_font_size }}px;
      --mobile-menu-row-gap: {{ section.settings.mobile_menu_row_gap }}px;
      --mobile-menu-overlay-opacity: {{ section.settings.mobile_menu_overlay_opacity | divided_by: 100.0 }};
      --mobile-social-icon-size: {{ section.settings.mobile_social_icon_size }}px;

      --mobile-login-bg: {{ login_bg }};
      --mobile-login-text: {{ login_text }};
    }
  }
{%- endstyle -%}

<style>
  /* Kept from Dawn: shared list-menu and account-element tokens. */
  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  shopify-account.header__icon {
    --shopify-account-font-heading: var(--font-heading-family);
    --shopify-account-font-heading-weight: var(--font-heading-weight);
    --shopify-account-font-body: var(--font-body-family);
    --shopify-account-font-body-weight: var(--font-body-weight);
    --shopify-account-radius-base: var(--popup-corner-radius);
    --shopify-account-radius-button: var(--buttons-radius);
    --shopify-account-radius-button-small: var(--buttons-radius);
    --shopify-account-radius-input: var(--inputs-radius);
    --shopify-account-color-background: rgb(var(--color-background));
    --shopify-account-color-text: rgb(var(--color-foreground));
    --shopify-account-color-accent: rgb(var(--color-button));
    --shopify-account-color-accent-text: rgb(var(--color-button-text));
    --shopify-account-dialog-position-top: var(--account-dialog-top, var(--header-height, 0px));
  }
</style>

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  id="Header-{{ section.id }}"
  class="header-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}"
>
  <header class="header header--menu-inline{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if country_selector or language_selector %} header--has-localizations{% endif %}">
    <div class="header__brand">
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link focus-inset">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
          {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
          {%- capture logo_widths -%}
            {{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}
          {%- endcapture -%}
          <span class="header__heading-logo-wrapper">
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo',
                widths: logo_widths,
                height: logo_height,
                width: settings.logo_width,
                alt: logo_alt,
                preload: true
            }}
          </span>
        {%- else -%}
          <span class="header__brand-text">{{ brand_text | escape }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    </div>

    {%- comment -%}
      The menu toggle is a direct child of the header row so the mobile layout
      can place it in its own grid column, left of the centred logo. It is
      display:none above the desktop breakpoint, so the desktop row is unchanged.
    {%- endcomment -%}
    {%- if section.settings.menu != blank -%}
      {%- render 'header-drawer',
        show_country_selector: country_selector,
        show_language_selector: language_selector,
        show_social_links: social_links,
        show_login: section.settings.show_login,
        login_label: section.settings.login_label
      -%}
    {%- endif -%}

    <div class="header__pill">
      {%- liquid
        if section.settings.menu != blank
          if section.settings.menu_type_desktop == 'dropdown'
            render 'header-dropdown-menu'
          elsif section.settings.menu_type_desktop != 'drawer'
            render 'header-mega-menu'
          endif
        endif
      -%}

      <div class="header__icons">
        {% render 'header-search', input_id: 'Search-In-Modal', section: section %}

        {%- if shop.customer_accounts_enabled -%}
          <shopify-account
            menu="{{ settings.customer_account_menu | default: 'customer-account-main-menu' }}"
            class="header__icon header__icon--account link focus-inset"
          >
            <span slot="signed-out-avatar" class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
            <span slot="signed-out-avatar" class="visually-hidden">{{ 'customer.log_in' | t }}</span>
          </shopify-account>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}

        {%- comment -%}
          Keep the href and the id: the href is the no-JS fallback, and
          cart-drawer.js binds the drawer to #cart-icon-bubble. The inner markup
          must mirror sections/cart-icon-bubble.liquid, which replaces it on
          every AJAX cart update.
        {%- endcomment -%}
        <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
          {% if cart == empty %}
            <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
          {% else %}
            <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
          {% endif %}
          <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
          {%- if cart != empty -%}
            <div class="cart-count-bubble">
              {%- if cart.item_count < 100 -%}
                <span aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>
      </div>
    </div>
  </header>
</{{ header_tag }}>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification',
    color_scheme: section.settings.color_scheme,
    desktop_menu_type: section.settings.menu_type_desktop
  -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
      this.setHeaderHeight = this.setHeaderHeight.bind(this);
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.mobileMediaQuery = window.matchMedia('(max-width: 990px)');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      this.mobileMediaQuery.addEventListener('change', this.setHeaderHeight);

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearches = this.querySelectorAll('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.mobileMediaQuery.removeEventListener('change', this.setHeaderHeight);
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if ([...this.predictiveSearches].some((predictiveSearch) => predictiveSearch.isOpen)) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach((disclosure) => disclosure.close());
    }

    closeSearchModal() {
      this.searchModals = this.searchModals || this.header.querySelectorAll('details-modal');
      this.searchModals.forEach((searchModal) => searchModal.close(false));
    }
  }

  // The account `open` event is composed but does not bubble, so listen during capture.
  // Anchor the dialog to the bottom of the account button itself. The header group can be
  // much taller than the button's row (for example, a top-left logo pushes the menu to a
  // second row), so anchoring to the section bottom drops the dialog too low.
  document.addEventListener(
    'open',
    (event) => {
      if (!(event.target instanceof HTMLElement) || !event.target.matches('shopify-account')) return;

      const bottom = Math.max(0, Math.round(event.target.getBoundingClientRect().bottom));
      event.target.style.setProperty('--account-dialog-top', `${bottom}px`);
    },
    true
  );

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "header_position",
      "label": "Header position",
      "info": "Overlay floats the header over the section below it.",
      "options": [
        {
          "value": "overlay",
          "label": "Overlay"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
      "default": "overlay"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "options": [
        {
          "value": "none",
          "label": "t:sections.header.settings.sticky_header_type.options__1.label"
        },
        {
          "value": "on-scroll-up",
          "label": "t:sections.header.settings.sticky_header_type.options__2.label"
        },
        {
          "value": "always",
