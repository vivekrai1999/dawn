{% comment %}
  Related products — Dawn's product recommendations, presented with the
  product-showcase layout: a heading, an optional description, circular
  carousel controls and a row of showcase product cards.

  Only the presentation is shared. The section keeps its own name, its
  `product-recommendations` custom element and its data attributes, so the
  Recommendations API and the Section Rendering API request that swaps this
  markup in on scroll keep working exactly as before.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-card-showcase.css' | asset_url | stylesheet_tag }}
{{ 'section-product-showcase.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_quick_add -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign quick_add_type = 'none'
  if section.settings.enable_quick_add
    assign quick_add_type = 'standard'
  endif

  comment
    Recommendations are fetched after the page renders, so products_count is 0
    on the first pass; the carousel is decided on the request that returns the
    cards, which is the same markup that gets swapped in.
  endcomment
  assign show_carousel = false
  if section.settings.enable_carousel and recommendations.products_count > section.settings.columns_desktop
    assign show_carousel = true
  endif

  comment
    Heading size stays a preset choice, since merchants already set it here, and
    is mapped to the pixel token the showcase heading reads.
  endcomment
  case section.settings.heading_size
    when 'hxxl'
      assign heading_size = 68
    when 'hxl'
      assign heading_size = 56
    when 'h0'
      assign heading_size = 44
    when 'h1'
      assign heading_size = 36
    else
      assign heading_size = 28
  endcase

  comment
    Colour settings can be cleared in the editor, so each one falls back to the
    section's colour scheme rather than to a hard-coded value.
  endcomment
  assign heading_color = section.settings.heading_color | default: 'rgb(var(--color-foreground))'
  assign text_color = section.settings.text_color | default: 'rgba(var(--color-foreground), 0.75)'
  assign title_color = section.settings.card_title_color | default: 'rgb(var(--color-foreground))'
  assign price_color = section.settings.card_price_color | default: 'rgba(var(--color-foreground), 0.72)'
  assign button_bg = section.settings.button_background_color | default: 'rgb(var(--color-foreground))'
  assign button_icon = section.settings.button_icon_color | default: 'rgb(var(--color-background))'

  comment
    The showcase card pins every media box to one ratio so the grid stays even.
    This keeps the merchant's Image ratio choice meaningful: portrait and square
    are already uniform, so they are passed through; "adapt" cannot be uniform by
    definition, so it falls back to the card's own default.
  endcomment
  assign card_media_ratio = ''
  if section.settings.image_ratio == 'portrait'
    assign card_media_ratio = '125%'
  elsif section.settings.image_ratio == 'square'
    assign card_media_ratio = '100%'
  endif
-%}

{%- style -%}
  #RelatedProducts-{{ section.id }} {
    --showcase-width: {{ section.settings.content_width }}px;
    --showcase-gap: {{ section.settings.grid_gap }}px;
    --showcase-columns: {{ section.settings.columns_desktop }};
    --showcase-columns-tablet: {{ section.settings.columns_tablet }};
    --showcase-columns-mobile: {{ section.settings.columns_mobile }};
    --showcase-padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --showcase-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;

    --showcase-heading: {{ heading_color }};
    --showcase-text: {{ text_color }};
    --showcase-heading-size: {{ heading_size }}px;
    --showcase-text-size: {{ section.settings.description_size }}px;
    --showcase-description-width: {{ section.settings.description_width }}px;
  }

  {%- comment -%}
    component-card-showcase.css declares the --card-* defaults on
    .card-wrapper--showcase itself, so a value set on an ancestor is overridden
    rather than inherited. The card has to be in the selector for these to land.
  {%- endcomment -%}
  #RelatedProducts-{{ section.id }} .card-wrapper--showcase {
    --card-title-color: {{ title_color }};
    --card-price-color: {{ price_color }};
    --card-media-radius: {{ section.settings.card_media_radius }}px;
    --card-title-size: {{ section.settings.card_title_size }}px;
    --card-price-size: {{ section.settings.card_price_size }}px;

    --card-button-bg: {{ button_bg }};
    --card-button-icon: {{ button_icon }};
    --card-button-size: {{ section.settings.button_size }}px;
    {%- if card_media_ratio != blank %}
      --card-media-ratio: {{ card_media_ratio }};
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    #RelatedProducts-{{ section.id }} {
      --showcase-padding-top: {{ section.settings.padding_top }}px;
      --showcase-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <product-recommendations
    id="RelatedProducts-{{ section.id }}"
    class="related-products product-showcase isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="product-showcase__inner">
        {%- if section.settings.heading != blank or section.settings.description != blank -%}
          <div class="product-showcase__header">
            <div class="product-showcase__intro">
              {%- if section.settings.heading != blank -%}
                <h2 class="product-showcase__heading inline-richtext" id="RelatedProductsHeading-{{ section.id }}">
                  {{- section.settings.heading -}}
                </h2>
              {%- endif -%}
              {%- if section.settings.description != blank -%}
                <div class="product-showcase__description rte">{{ section.settings.description }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <slider-component class="product-showcase__slider{% unless show_carousel %} product-showcase__slider--static{% endunless %}">
          {%- if show_carousel and section.settings.show_navigation -%}
            <div class="product-showcase__controls">
              <button
                type="button"
                name="previous"
                class="product-showcase__arrow product-showcase__arrow--prev"
                aria-label="{{ 'general.slider.previous_slide' | t }}"
                aria-controls="Slider-{{ section.id }}"
              >
                <span class="svg-wrapper" aria-hidden="true">
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
              </button>
              <button
                type="button"
                name="next"
                class="product-showcase__arrow product-showcase__arrow--next"
                aria-label="{{ 'general.slider.next_slide' | t }}"
                aria-controls="Slider-{{ section.id }}"
              >
                <span class="svg-wrapper" aria-hidden="true">
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- endif -%}

          <ul
            class="product-showcase__track{% if show_carousel %} slider slider--everywhere{% endif %}"
            id="Slider-{{ section.id }}"
            role="list"
          >
            {%- for recommendation in recommendations.products -%}
              <li
                class="grid__item product-showcase__item{% if show_carousel %} slider__slide{% endif %}"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
              >
                {%- render 'card-product',
                  card_product: recommendation,
                  card_variant: 'showcase',
                  quick_add: quick_add_type,
                  quick_add_style: 'icon',
                  section_id: section.id,
                  media_aspect_ratio: section.settings.image_ratio,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  skip_styles: true,
                  product_view_context: 'recommendation'
                -%}
              </li>
            {%- endfor -%}
          </ul>
        </slider-component>
      </div>
    {%- endif -%}
  </product-recommendations>
</div>

{% schema %}
{
  "name": "t:sections.related-products.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.related-products.settings.paragraph__1.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.related-products.settings.paragraph__1.default",
      "label": "t:sections.related-products.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 15
    },
    {
      "type": "range",
      "id": "description_width",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Description width",
      "default": 760
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "t:sections.related-products.settings.products_to_show.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.related-products.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Products per row (tablet)"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.related-products.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.related-products.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.related-products.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap between products",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 1000,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1800
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable carousel",
      "info": "Applies when there are more products than fit in a row.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.related-products.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.related-products.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.related-products.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.related-products.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.related-products.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "card_media_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.related-products.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.related-products.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "t:sections.related-products.settings.enable_quick_add.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.related-products.settings.show_rating.label",
      "info": "t:sections.related-products.settings.show_rating.info"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 15
    },
    {
      "type": "range",
      "id": "card_price_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Price size",
      "default": 15
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 36,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Quick add button size",
      "default": 44
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "info": "Leave blank to inherit the color scheme."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Product title"
    },
    {
      "type": "color",
      "id": "card_price_color",
      "label": "Price"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Quick add background"
    },
    {
      "type": "color",
      "id": "button_icon_color",
      "label": "Quick add icon"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
