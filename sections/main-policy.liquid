{% comment %}
  Shop policy — the section behind templates/policy.json.

  Refund policy, Privacy policy, Terms of service, Shipping policy and Contact
  information are not pages. They are the policy documents written in Shopify
  admin under Settings › Policies, and Shopify renders each of them at
  /policies/… through the `policy` template.

  Until this file existed the theme had no policy template at all, so those URLs
  fell back to Shopify's own bare rendering — which is why the policy pages did
  not look like the rest of the store. The content still comes from admin; this
  only gives it the store's typography, measure and gutters.
{% endcomment %}

{{ 'section-main-policy.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #Policy-{{ section.id }} {
    --policy-width: {{ section.settings.content_width }}px;
    --policy-measure: {{ section.settings.text_width }}px;
    --policy-heading-size: {{ section.settings.heading_size }}px;
    --policy-body-size: {{ section.settings.body_size }}px;
    --policy-padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --policy-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #Policy-{{ section.id }} {
      --policy-padding-top: {{ section.settings.padding_top }}px;
      --policy-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="Policy-{{ section.id }}"
  class="policy color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="policy__inner">
    {%- comment -%}
      `policy` is provided by Shopify only in the policy template, which is the
      one context this section renders in. Theme Check analyses files without
      that context and cannot know the object exists here.
    {%- endcomment -%}
    {% # theme-check-disable UndefinedObject %}
    <h1 class="policy__heading">{{ policy.title }}</h1>

    <div class="policy__body rte">
      {{ policy.body }}
    </div>
    {% # theme-check-enable UndefinedObject %}

    {%- if section.settings.show_contact_note and section.settings.contact_note != blank -%}
      <aside class="policy__note">
        <div class="rte">{{ section.settings.contact_note }}</div>
      </aside>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Policy",
  "tag": "section",
  "class": "section section--policy",
  "settings": [
    {
      "type": "paragraph",
      "content": "The wording of each policy is edited in Settings › Policies, not here."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 44
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Body size",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_width",
      "min": 480,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Text width",
      "info": "Legal text is read line by line, so it is kept to a short measure.",
      "default": 760
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 1000,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1800
    },
    {
      "type": "header",
      "content": "Footnote"
    },
    {
      "type": "checkbox",
      "id": "show_contact_note",
      "label": "Show a note at the end",
      "default": true
    },
    {
      "type": "richtext",
      "id": "contact_note",
      "label": "Note",
      "default": "<p>Still not sure where you stand? <a href=\"/pages/contact\">Get in touch</a> and a person will answer.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ]
}
{% endschema %}
