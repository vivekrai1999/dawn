{% comment %}
  Page hero — the title block that opens a content page.

  Every page built on this theme's own templates starts with this section, so
  Contact, Shipping, Returns, Care, Tracking, FAQs and the policy pages all
  share one heading treatment rather than each inventing its own.

  The heading falls back to the page's own title, so a merchant who never opens
  the section still gets the right words.

  Reused from the theme: the colour-scheme system, the page gutter used by
  sections/product-showcase.liquid, and the typographic scale of the showcase
  heading.
{% endcomment %}

{{ 'section-page-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_heading = section.settings.heading | default: page.title
-%}

{%- style -%}
  #PageHero-{{ section.id }} {
    --page-hero-width: {{ section.settings.content_width }}px;
    --page-hero-measure: {{ section.settings.text_width }}px;
    --page-hero-heading-size: {{ section.settings.heading_size }}px;
    --page-hero-body-size: {{ section.settings.body_size }}px;
    --page-hero-padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --page-hero-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #PageHero-{{ section.id }} {
      --page-hero-padding-top: {{ section.settings.padding_top }}px;
      --page-hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="PageHero-{{ section.id }}"
  class="page-hero page-hero--{{ section.settings.alignment }} color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="page-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="page-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if hero_heading != blank -%}
      <h1 class="page-hero__heading">{{ hero_heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <div class="page-hero__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Page hero",
  "tag": "section",
  "class": "section section--page-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page's own title."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 44
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Intro size",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Text width",
      "info": "Keeps a line of prose short enough to read comfortably.",
      "default": 640
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 1000,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1800
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Page hero"
    }
  ]
}
{% endschema %}
