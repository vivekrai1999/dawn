{% comment %}
  Process / How it works — a list of steps beside the media for the selected
  step.

  Each step is a section block, so the merchant adds, reorders and removes them
  in the Theme Editor.

  Every step's media and copy is rendered, and the first one is marked active
  here in Liquid. assets/process.js only moves that mark around in response to a
  click, an arrow key or the autoplay timer — so with no JavaScript the section
  still shows a complete first step, and every step's text is still in the page.

  The steps are a tab list: each button controls the panel it names, one tab is
  in the tab order at a time, and the arrow keys move between them.

  Reused from the theme: the colour-scheme system, the page-width gutter, and
  Dawn's responsive image helpers.
{% endcomment %}

{{ 'section-process.css' | asset_url | stylesheet_tag }}
<script src="{{ 'process.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign steps = section.blocks | where: 'type', 'step'

  comment
    A step with neither a title nor an image would render as an empty row.
  endcomment
  assign renderable = 0
  for block in steps
    if block.settings.title != blank or block.settings.image != blank
      assign renderable = renderable | plus: 1
    endif
  endfor
-%}

{%- if renderable > 0 -%}
  {%- style -%}
    #Process-{{ section.id }} {
      --process-width: {{ section.settings.content_width }}px;
      --process-list-width: {{ section.settings.list_width }}px;
      --process-heading-size: {{ section.settings.heading_size }}px;
      --process-body-size: {{ section.settings.body_size }}px;
      --process-media-ratio: {{ section.settings.image_ratio }};
      --process-media-fit: {{ section.settings.image_fit }};
      --process-dwell: {{ section.settings.autoplay_duration }}ms;
      --process-padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      --process-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      #Process-{{ section.id }} {
        --process-padding-top: {{ section.settings.padding_top }}px;
        --process-padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div id="Process-{{ section.id }}" class="process color-{{ section.settings.color_scheme }} gradient">
    <div class="process__inner">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="process__header process__header--{{ section.settings.heading_alignment }}">
          {%- if section.settings.heading != blank -%}
            <h2 class="process__heading" id="ProcessHeading-{{ section.id }}">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="process__subheading rte">{{ section.settings.subheading }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <process-steps
        class="process__layout{% if section.settings.autoplay %} process--autoplay{% endif %}"
        data-autoplay="{{ section.settings.autoplay }}"
        data-autoplay-speed="{{ section.settings.autoplay_duration }}"
      >
        <div class="process__list-column">
          <ul
            class="process__list"
            role="tablist"
            {% if section.settings.heading != blank %}
              aria-labelledby="ProcessHeading-{{ section.id }}"
            {% endif %}
          >
            {%- assign step_index = 0 -%}
            {%- for block in steps -%}
              {%- if block.settings.title == blank and block.settings.image == blank -%}
                {%- continue -%}
              {%- endif -%}

              {%- liquid
                assign is_active = false
                if step_index == 0
                  assign is_active = true
                endif
                comment
                  A step may be an image with no title; the tab still needs a
                  name, so it falls back to its position.
                endcomment
                assign step_number = step_index | plus: 1
                assign step_title = block.settings.title
                if step_title == blank
                  assign step_title = 'Step ' | append: step_number
                endif
              -%}

              <li
                class="process__item"
                data-process-item
                data-state="{% if is_active %}current{% else %}todo{% endif %}"
                {{ block.shopify_attributes }}
              >
                <button
                  type="button"
                  class="process__step"
                  role="tab"
                  id="ProcessTab-{{ section.id }}-{{ step_index }}"
                  aria-controls="ProcessPanel-{{ section.id }}-{{ step_index }}"
                  aria-selected="{% if is_active %}true{% else %}false{% endif %}"
                  tabindex="{% if is_active %}0{% else %}-1{% endif %}"
                  data-process-tab
                >
                  <span class="process__step-number" aria-hidden="true">{{ step_number }}</span>
                  <span class="process__step-text">
                    <span class="process__step-title">{{ step_title | escape }}</span>
                    {%- if block.settings.description != blank -%}
                      <span class="process__step-summary">
                        {{- block.settings.description | strip_html -}}
                      </span>
                    {%- endif -%}
                  </span>
                </button>

                {%- comment -%}
                  Outside the button on purpose: a link nested inside another
                  control is not reachable as its own target, by pointer or by
                  keyboard.
                {%- endcomment -%}
                {%- if block.settings.link != blank and block.settings.link_text != blank -%}
                  <a class="process__link link" href="{{ block.settings.link }}">
                    {{- block.settings.link_text | escape -}}
                  </a>
                {%- endif -%}
              </li>
              {%- assign step_index = step_index | plus: 1 -%}
            {%- endfor -%}
          </ul>
        </div>

        <div class="process__media">
            {%- assign step_index = 0 -%}
            {%- for block in steps -%}
              {%- if block.settings.title == blank and block.settings.image == blank -%}
                {%- continue -%}
              {%- endif -%}

              {%- liquid
                assign is_active = false
                if step_index == 0
                  assign is_active = true
                endif

                comment
                  Only the step on show at first paint is worth loading eagerly;
                  the rest are behind a click.
                endcomment
                assign loading_attr = 'lazy'
                if is_active
                  assign loading_attr = 'eager'
                endif
              -%}

              <div
                class="process__panel{% if is_active %} process__panel--active{% endif %}"
                id="ProcessPanel-{{ section.id }}-{{ step_index }}"
                role="tabpanel"
                aria-labelledby="ProcessTab-{{ section.id }}-{{ step_index }}"
                data-process-panel
                {% unless is_active %}
                  inert
                {% endunless %}
              >
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1600
                    | image_tag:
                      loading: loading_attr,
                      class: 'process__image',
                      widths: '375, 550, 750, 1100, 1500',
                      sizes: '(min-width: 750px) 60vw, 100vw',
                      alt: block.settings.image.alt
                  }}
                {%- else -%}
                  {{ 'collection-apparel-1' | placeholder_svg_tag: 'process__placeholder' }}
                {%- endif -%}
              </div>
              {%- assign step_index = step_index | plus: 1 -%}
            {%- endfor -%}
        </div>
      </process-steps>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Process",
  "tag": "section",
  "class": "section section--process",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pick your yarn"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Tell the shopper what happens at this stage, and what they need to do.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link label",
          "info": "The link is shown only when it has a label."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Four steps from the first stitch to the finished piece.</p>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 40
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Body size",
      "default": 15
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "info": "Applies on mobile. From tablet up the image matches the height of the step list beside it.",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "info": "Fill crops the image to the shape above; Fit shows all of it inside the frame.",
      "options": [
        {
          "value": "cover",
          "label": "Fill the frame"
        },
        {
          "value": "contain",
          "label": "Fit the whole image"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "list_width",
      "min": 240,
      "max": 560,
      "step": 20,
      "unit": "px",
      "label": "Step list width",
      "info": "Applies from tablet up.",
      "default": 400
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 1000,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1800
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Advance steps automatically",
      "info": "Pauses on hover, on keyboard focus, while the section is off screen, and for visitors who prefer reduced motion.",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_duration",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "label": "Time on each step",
      "default": 4000
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Process",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
